<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Macro & Calorie Tracker</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent-green: #10b981;
            --accent-blue: #3b82f6;
            --accent-amber: #f59e0b;
            --accent-red: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding: 20px;
            max-width: 900px;
            margin: 0 auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 25px;
        }

        .date-picker {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 12px;
            border-radius: 8px;
        }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
        }

        .card-title {
            font-size: 13px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .card-value {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .progress-bar {
            height: 8px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            transition: width 0.3s ease;
        }

        .fill-calories { background-color: var(--accent-green); }
        .fill-protein { background-color: var(--accent-blue); }
        .fill-carbs { background-color: var(--accent-amber); }
        .fill-fat { background-color: var(--accent-red); }

        .section-box {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
        }

        .search-container {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        input[type="text"], input[type="number"] {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            width: 100%;
        }

        button {
            background: var(--accent-blue);
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-add { background: var(--accent-green); }

        .search-results {
            max-height: 200px;
            overflow-y: auto;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            margin-bottom: 15px;
            display: none;
        }

        .search-item {
            padding: 10px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }

        .grid-inputs {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: 10px;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th, td {
            padding: 12px 10px;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
        }

        .btn-delete {
            background: transparent;
            color: var(--accent-red);
            border: 1px solid var(--accent-red);
            padding: 4px 8px;
            font-size: 12px;
            border-radius: 6px;
        }

        .goals-section {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-top: 15px;
            font-size: 13px;
            color: var(--text-muted);
            flex-wrap: wrap;
        }

        .goals-section input {
            width: 80px;
            padding: 4px 8px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div>
            <h2>MacroTracker</h2>
            <p style="color: var(--text-muted); font-size: 13px;">Kostenloser Yazio-Style Tracker</p>
        </div>
        <input type="date" id="track-date" class="date-picker">
    </div>

    <div class="dashboard">
        <div class="card">
            <div class="card-title">Kalorien</div>
            <div class="card-value"><span id="curr-kcal">0</span> / <span id="target-kcal">2000</span> <small>kcal</small></div>
            <div class="progress-bar"><div id="prog-kcal" class="progress-fill fill-calories" style="width: 0%;"></div></div>
        </div>
        <div class="card">
            <div class="card-title">Protein</div>
            <div class="card-value"><span id="curr-protein">0</span> / <span id="target-protein">150</span> <small>g</small></div>
            <div class="progress-bar"><div id="prog-protein" class="progress-fill fill-protein" style="width: 0%;"></div></div>
        </div>
        <div class="card">
            <div class="card-title">Kohlenhydrate</div>
            <div class="card-value"><span id="curr-carbs">0</span> / <span id="target-carbs">200</span> <small>g</small></div>
            <div class="progress-bar"><div id="prog-carbs" class="progress-fill fill-carbs" style="width: 0%;"></div></div>
        </div>
        <div class="card">
            <div class="card-title">Fett</div>
            <div class="card-value"><span id="curr-fat">0</span> / <span id="target-fat">65</span> <small>g</small></div>
            <div class="progress-bar"><div id="prog-fat" class="progress-fill fill-fat" style="width: 0%;"></div></div>
        </div>
    </div>

    <div class="section-box">
        <h3 style="margin-bottom: 10px;">Lebensmittel hinzufügen</h3>
        <div class="search-container">
            <input type="text" id="api-search-input" placeholder="Online suchen (z. B. Protein Wrap)...">
            <button onclick="searchOpenFoodFacts()">Suchen</button>
        </div>
        <div id="search-results" class="search-results"></div>

        <div class="grid-inputs">
            <input type="text" id="input-name" placeholder="Name">
            <input type="number" id="input-kcal" placeholder="Kcal">
            <input type="number" id="input-protein" placeholder="Protein (g)">
            <input type="number" id="input-carbs" placeholder="Carbs (g)">
            <input type="number" id="input-fat" placeholder="Fett (g)">
        </div>
        <button class="btn-add" onclick="addCustomFood()" style="width: 100%;">Eintrag speichern</button>
    </div>

    <div class="section-box">
        <h3 style="margin-bottom: 10px;">Tagesprotokoll</h3>
        <div style="overflow-x: auto;">
            <table>
                <thead>
                    <tr>
                        <th>Lebensmittel</th>
                        <th>Kcal</th>
                        <th>Protein</th>
                        <th>Carbs</th>
                        <th>Fett</th>
                        <th>Aktion</th>
                    </tr>
                </thead>
                <tbody id="log-table-body"></tbody>
            </table>
        </div>
    </div>

    <div class="section-box">
        <h3 style="margin-bottom: 10px;">Tagesziele anpassen</h3>
        <div class="goals-section">
            <label>Kcal: <input type="number" id="goal-kcal-input" value="2000"></label>
            <label>Protein: <input type="number" id="goal-protein-input" value="150"></label>
            <label>Carbs: <input type="number" id="goal-carbs-input" value="200"></label>
            <label>Fett: <input type="number" id="goal-fat-input" value="65"></label>
            <button onclick="updateGoals()">Speichern</button>
        </div>
    </div>

    <script>
        let targets = { kcal: 2000, protein: 150, carbs: 200, fat: 65 };
        const currentDateInput = document.getElementById('track-date');
        currentDateInput.valueAsDate = new Date();

        window.onload = function() {
            loadGoals();
            loadLog();
            currentDateInput.addEventListener('change', loadLog);
        };

        function getStorageKey() { return `macro_log_${currentDateInput.value}`; }

        function loadGoals() {
            const saved = localStorage.getItem('macro_goals');
            if (saved) {
                targets = JSON.parse(saved);
                document.getElementById('goal-kcal-input').value = targets.kcal;
                document.getElementById('goal-protein-input').value = targets.protein;
                document.getElementById('goal-carbs-input').value = targets.carbs;
                document.getElementById('goal-fat-input').value = targets.fat;
            }
            updateDashboardTargets();
        }

        function updateGoals() {
            targets.kcal = parseFloat(document.getElementById('goal-kcal-input').value) || 2000;
            targets.protein = parseFloat(document.getElementById('goal-protein-input').value) || 150;
            targets.carbs = parseFloat(document.getElementById('goal-carbs-input').value) || 200;
            targets.fat = parseFloat(document.getElementById('goal-fat-input').value) || 65;
            localStorage.setItem('macro_goals', JSON.stringify(targets));
            updateDashboardTargets();
            calculateTotals();
        }

        function updateDashboardTargets() {
            document.getElementById('target-kcal').innerText = targets.kcal;
            document.getElementById('target-protein').innerText = targets.protein;
            document.getElementById('target-carbs').innerText = targets.carbs;
            document.getElementById('target-fat').innerText = targets.fat;
        }

        function loadLog() {
            const data = localStorage.getItem(getStorageKey());
            const items = data ? JSON.parse(data) : [];
            renderTable(items);
            calculateTotals(items);
        }

        function saveLog(items) {
            localStorage.setItem(getStorageKey(), JSON.stringify(items));
            renderTable(items);
            calculateTotals(items);
        }

        function addCustomFood() {
            const name = document.getElementById('input-name').value;
            const kcal = parseFloat(document.getElementById('input-kcal').value) || 0;
            const protein = parseFloat(document.getElementById('input-protein').value) || 0;
            const carbs = parseFloat(document.getElementById('input-carbs').value) || 0;
            const fat = parseFloat(document.getElementById('input-fat').value) || 0;

            if (!name) return alert('Bitte Name eingeben');

            const items = JSON.parse(localStorage.getItem(getStorageKey()) || '[]');
            items.push({ id: Date.now(), name, kcal, protein, carbs, fat });
            saveLog(items);

            document.getElementById('input-name').value = '';
            document.getElementById('input-kcal').value = '';
            document.getElementById('input-protein').value = '';
            document.getElementById('input-carbs').value = '';
            document.getElementById('input-fat').value = '';
        }

        function deleteItem(id) {
            let items = JSON.parse(localStorage.getItem(getStorageKey()) || '[]');
            items = items.filter(item => item.id !== id);
            saveLog(items);
        }

        function renderTable(items) {
            const tbody = document.getElementById('log-table-body');
            tbody.innerHTML = '';
            if (items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color: var(--text-muted);">Keine Einträge.</td></tr>';
                return;
            }
            items.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><strong>${item.name}</strong></td>
                    <td>${item.kcal}</td>
                    <td>${item.protein}g</td>
                    <td>${item.carbs}g</td>
                    <td>${item.fat}g</td>
                    <td><button class="btn-delete" onclick="deleteItem(${item.id})">x</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function calculateTotals(items) {
            if (!items) items = JSON.parse(localStorage.getItem(getStorageKey()) || '[]');
            let totals = { kcal: 0, protein: 0, carbs: 0, fat: 0 };
            items.forEach(item => {
                totals.kcal += item.kcal;
                totals.protein += item.protein;
                totals.carbs += item.carbs;
                totals.fat += item.fat;
            });

            document.getElementById('curr-kcal').innerText = Math.round(totals.kcal);
            document.getElementById('curr-protein').innerText = Math.round(totals.protein);
            document.getElementById('curr-carbs').innerText = Math.round(totals.carbs);
            document.getElementById('curr-fat').innerText = Math.round(totals.fat);

            document.getElementById('prog-kcal').style.width = Math.min((totals.kcal / targets.kcal) * 100, 100) + '%';
            document.getElementById('prog-protein').style.width = Math.min((totals.protein / targets.protein) * 100, 100) + '%';
            document.getElementById('prog-carbs').style.width = Math.min((totals.carbs / targets.carbs) * 100, 100) + '%';
            document.getElementById('prog-fat').style.width = Math.min((totals.fat / targets.fat) * 100, 100) + '%';
        }

        async function searchOpenFoodFacts() {
            const query = document.getElementById('api-search-input').value;
            const resultsBox = document.getElementById('search-results');
            if (!query) return;
            resultsBox.style.display = 'block';
            resultsBox.innerHTML = '<div style="padding:10px;">Suche...</div>';

            try {
                const res = await fetch(`https://de.openfoodfacts.org/cgi/search.pl?search_terms=${encodeURIComponent(query)}&search_simple=1&action=process&json=1&page_size=5`);
                const data = await res.json();
                resultsBox.innerHTML = '';
                if (data.products && data.products.length > 0) {
                    data.products.forEach(p => {
                        const n = p.nutriments || {};
                        const name = p.product_name || 'Unbenannt';
                        const kcal = Math.round(n['energy-kcal_100g'] || 0);
                        const protein = Math.round(n.proteins_100g || 0);
                        const carbs = Math.round(n.carbohydrates_100g || 0);
                        const fat = Math.round(n.fat_100g || 0);

                        const div = document.createElement('div');
                        div.className = 'search-item';
                        div.innerHTML = `<div><strong>${name}</strong> (100g)<br><small>${kcal} kcal | P:${protein}g</small></div><button class="btn-add">+</button>`;
                        div.onclick = () => {
                            document.getElementById('input-name').value = name + ' (100g)';
                            document.getElementById('input-kcal').value = kcal;
                            document.getElementById('input-protein').value = protein;
                            document.getElementById('input-carbs').value = carbs;
                            document.getElementById('input-fat').value = fat;
                            resultsBox.style.display = 'none';
                        };
                        resultsBox.appendChild(div);
                    });
                } else {
                    resultsBox.innerHTML = '<div style="padding:10px;">Nichts gefunden.</div>';
                }
            } catch (err) {
                resultsBox.innerHTML = '<div style="padding:10px;">Fehler bei der Suche.</div>';
            }
        }
    </script>
</body>
</html>
